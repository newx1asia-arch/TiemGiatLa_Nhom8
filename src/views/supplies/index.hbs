<div class="page-head">
    <div>
        <h1>Quản lý kho vật tư</h1>
        <p>Theo dõi tồn kho, nhập và xuất vật tư phục vụ tiệm.</p>
    </div>
    <a href="/supplies/create" class="btn btn-primary">{{> icon name="plus"}} Thêm vật tư</a>
</div>

{{#if lowCount}}
<div class="alert alert-warning">{{> icon name="alert"}} Có <b>{{lowCount}}</b> vật tư sắp hết, cần nhập thêm.</div>
{{/if}}

<div class="card flush">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Tên vật tư</th>
          <th class="num">Tồn kho</th>
          <th>Đơn vị</th>
          <th class="num">Giá nhập</th>
          <th>Trạng thái</th>
          <th>Nhập / Xuất</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        {{#each supplies}}
        <tr>
          <td><b>{{this.name}}</b></td>
          <td class="num">{{this.quantity}}</td>
          <td>{{this.unit}}</td>
          <td class="num">{{formatPrice this.price}}</td>
          <td>
            {{#if this.isLow}}<span class="badge badge-warn">Sắp hết</span>{{else}}<span class="badge badge-ok">Đủ dùng</span>{{/if}}
          </td>
          <td>
            <form action="/supplies/{{this._id}}/adjust" method="POST" class="table-actions">
{{> csrf}}
              <input class="field-input" type="number" name="amount" min="1" required aria-label="Số lượng">
              <select class="field-select" name="type" aria-label="Loại">
                <option value="in">Nhập</option>
                <option value="out">Xuất</option>
              </select>
              <button type="submit" class="btn btn-secondary btn-sm">Áp dụng</button>
            </form>
          </td>
          <td>
            <div class="table-actions">
              <a href="/supplies/{{this._id}}/edit" class="btn btn-secondary btn-sm">Sửa</a>
              {{#if @root.isOwner}}
              <form action="/supplies/{{this._id}}?_method=DELETE" method="POST"
                    onsubmit="return confirm('Xóa vật tư này?')">
{{> csrf}}
                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
              </form>
              {{/if}}
            </div>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="empty-state">Chưa có vật tư nào.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
