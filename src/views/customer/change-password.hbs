<h2 class="page-title">Đổi mật khẩu</h2>

<div class="card auth-card">
    {{#if error}}<div class="field-error">{{error}}</div>{{/if}}
    {{#if success}}<div class="field-success">{{success}}</div>{{/if}}

    <form method="POST" action="/me/change-password">
        <div class="field-group">
            <label class="field-label">Mật khẩu hiện tại</label>
            <input class="field-input" type="password" name="currentPassword" required>
        </div>
        <div class="field-group">
            <label class="field-label">Mật khẩu mới</label>
            <input class="field-input" type="password" name="newPassword" required minlength="6">
        </div>
        <div class="field-group">
            <label class="field-label">Xác nhận mật khẩu mới</label>
            <input class="field-input" type="password" name="confirmPassword" required minlength="6">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Đổi mật khẩu</button>
    </form>

    <p class="form-footer"><a href="/me/profile">&larr; Quay lại hồ sơ</a></p>
</div>
