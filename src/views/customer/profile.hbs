<div class="pf" data-points="{{customer.points}}" data-lifetime="{{customer.lifetimePoints}}">

    <!-- Thẻ thành viên -->
    <section class="pf-hero t0" id="pfHero">
        <div class="pf-hero-top">
            <span class="pf-avatar">{{initials customer.name}}</span>
            <div class="pf-who">
                <span class="pf-hello">Hồ sơ của tôi</span>
                <h1>{{customer.name}}</h1>
                <span class="pf-code">{{customer.code}}</span>
            </div>
            <span class="pf-tier" id="pfTier">Đồng</span>
        </div>

        <div class="pf-meter">
            <div class="pf-meter-top">
                <span id="pfNow">Thành viên Đồng</span>
                <span id="pfNext">Còn 100 điểm để lên hạng Bạc</span>
            </div>
            <div class="pf-track"><i id="pfFill"></i></div>
        </div>
    </section>

    <!-- Thống kê -->
    <section class="pf-stats">
        <div class="pf-stat">
            <span class="pf-stat-ic c-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6.5 7 .9-5.1 4.9 1.3 7L12 17.8 5.8 21.3l1.3-7L2 9.4l7-.9z"/></svg>
            </span>
            <div>
                <div class="pf-stat-label">Điểm tích lũy</div>
                <div class="pf-stat-value">{{#if customer.points}}{{customer.points}}{{else}}0{{/if}}</div>
            </div>
        </div>
        <div class="pf-stat">
            <span class="pf-stat-ic c-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            </span>
            <div>
                <div class="pf-stat-label">Số đơn đã gửi</div>
                <div class="pf-stat-value">{{#if orderCount}}{{orderCount}}{{else}}0{{/if}}</div>
            </div>
        </div>
        <div class="pf-stat">
            <span class="pf-stat-ic c-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20"/></svg>
            </span>
            <div>
                <div class="pf-stat-label">Hạng thành viên</div>
                <div class="pf-stat-value" id="pfTierName">Đồng</div>
            </div>
        </div>
    </section>

    <p class="pf-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <span>Tích điểm: mỗi {{formatPrice loyalty.earnUnit}} thanh toán được 1 điểm. Dùng điểm: 1 điểm giảm {{formatPrice loyalty.pointValue}}, tối đa {{loyalty.maxRedeemPercent}}% giá trị đơn. Điểm được cộng sau khi đơn được thanh toán.</span>
    </p>

    <div class="pf-grid">
        <section class="pf-card">
            <h3>Thông tin liên hệ</h3>
            <ul class="pf-info">
                <li><span>Mã khách hàng</span><b class="mono">{{customer.code}}</b></li>
                <li><span>Số điện thoại</span><b>{{customer.phone}}</b></li>
                <li><span>Email</span><b>{{#if customer.email}}{{customer.email}}{{else}}<em>Chưa cập nhật</em>{{/if}}</b></li>
                <li><span>Địa chỉ</span><b>{{#if customer.address}}{{customer.address}}{{else}}<em>Chưa cập nhật</em>{{/if}}</b></li>
                <li><span>Ngày tham gia</span><b>{{dateFormat customer.createdAt}}</b></li>
            </ul>
        </section>

        <section class="pf-card">
            <h3>Dịch vụ của tôi</h3>
            <div class="pf-actions">
                {{#if isStaff}}<a href="/orders/create" class="main"><i class="pf-ic">{{> icon name="plus"}}</i><span><b>Tạo đơn giặt mới</b><small>Lập đơn tại quầy</small></span></a>{{/if}}
                <a href="/me/history"><i class="pf-ic">{{> icon name="clock"}}</i><span><b>Lịch sử giặt</b><small>Xem các đơn đã gửi</small></span></a>
                <a href="/me/card"><i class="pf-ic">{{> icon name="card"}}</i><span><b>Thẻ trả trước</b><small>Số dư và giao dịch</small></span></a>
                <a href="/me/profile/edit"><i class="pf-ic">{{> icon name="edit"}}</i><span><b>Chỉnh sửa thông tin</b><small>Cập nhật email, địa chỉ</small></span></a>
                <a href="/me/change-password"><i class="pf-ic">{{> icon name="lock"}}</i><span><b>Đổi mật khẩu</b><small>Bảo vệ tài khoản</small></span></a>
            </div>
        </section>
    </div>
</div>

<script>
(function () {
    var tiers = [
        { name: 'Đồng',      min: 0,   cls: 't0' },
        { name: 'Bạc',       min: 100, cls: 't1' },
        { name: 'Vàng',      min: 300, cls: 't2' },
        { name: 'Kim cương', min: 600, cls: 't3' }
    ];
    var pf = document.querySelector('.pf');
    var pts = Math.max(parseInt(pf.dataset.points, 10) || 0, parseInt(pf.dataset.lifetime, 10) || 0);

    var idx = 0;
    tiers.forEach(function (t, i) { if (pts >= t.min) idx = i; });
    var cur = tiers[idx], next = tiers[idx + 1];

    document.getElementById('pfTierName').textContent = cur.name;
    document.getElementById('pfTier').textContent = cur.name;
    document.getElementById('pfHero').className = 'pf-hero ' + cur.cls;
    document.getElementById('pfNow').textContent = 'Thành viên ' + cur.name;

    var percent = 100;
    if (next) {
        percent = Math.round(((pts - cur.min) / (next.min - cur.min)) * 100);
        document.getElementById('pfNext').textContent = 'Còn ' + (next.min - pts) + ' điểm để lên hạng ' + next.name;
    } else {
        document.getElementById('pfNext').textContent = 'Đã đạt hạng cao nhất';
    }
    var fill = document.getElementById('pfFill');
    requestAnimationFrame(function () {
        fill.style.width = Math.max(percent, 3) + '%';
    });
})();
</script>