<div class="page-head">
    <div>
        <h1>Khách hàng</h1>
        <p>Tìm khách, thêm khách vãng lai (chỉ cần tên và số điện thoại) và cấp mật khẩu đăng nhập khi khách yêu cầu.</p>
    </div>
    <a href="/orders/create" class="btn btn-primary">{{> icon name="plus"}} Tạo đơn hàng</a>
</div>

{{#if success}}<div class="field-success">{{success}}</div>{{/if}}
{{#if error}}<div class="field-error">{{error}}</div>{{/if}}
{{#if resetLink}}
<div class="card mt-1">
    <label class="field-label" for="resetLink">Link đặt lại mật khẩu</label>
    <input class="field-input" id="resetLink" type="text" value="{{resetLink}}" readonly onfocus="this.select()">
    <span class="field-hint">Chỉ hiển thị một lần. Đưa link cho khách để khách tự đặt mật khẩu mới.</span>
</div>
{{/if}}

<div class="stat-grid">
    <div class="stat"><div class="stat-label">Khách đang hiển thị</div><div class="stat-value" id="cu-total">0</div></div>
    <div class="stat ok"><div class="stat-label">Có tài khoản</div><div class="stat-value" id="cu-acc">0</div></div>
    <div class="stat warn"><div class="stat-label">Chưa có tài khoản</div><div class="stat-value" id="cu-noacc">0</div></div>
    <div class="stat"><div class="stat-label">Tổng điểm</div><div class="stat-value" id="cu-points">0</div></div>
</div>

<details class="card cu-add">
    <summary>{{> icon name="plus"}} Thêm khách vãng lai</summary>
    <form action="/admin/customers" method="POST" class="svc-edit cu-add-form">
        {{> csrf}}
        <input class="field-input" type="text" name="name" value="{{old.name}}" maxlength="255" required placeholder="Họ tên" aria-label="Họ tên">
        <input class="field-input" type="tel" name="phone" value="{{old.phone}}" maxlength="10" required placeholder="Số điện thoại" aria-label="Số điện thoại">
        <input class="field-input" type="text" name="address" value="{{old.address}}" maxlength="500" placeholder="Địa chỉ (tùy chọn)" aria-label="Địa chỉ">
        <button type="submit" class="btn btn-primary">Thêm khách</button>
    </form>
</details>

<div class="card flush">
    <form method="GET" action="/admin/customers" class="toolbar">
        <input class="field-input grow" type="search" name="q" value="{{q}}" placeholder="Tìm theo tên, số điện thoại hoặc mã KH..." aria-label="Tìm khách hàng">
        <button type="submit" class="btn btn-secondary">{{> icon name="search"}} Tìm</button>
    </form>

    {{#if customers.length}}
    <div class="cu-tabs">
        <div class="tabs" id="cu-tabs">
            <a href="#" class="active" data-f="all">Tất cả <span class="tab-n" data-n="all"></span></a>
            <a href="#" data-f="acc">Có tài khoản <span class="tab-n" data-n="acc"></span></a>
            <a href="#" data-f="noacc">Chưa có tài khoản <span class="tab-n" data-n="noacc"></span></a>
        </div>
        <input class="field-input cu-live" id="cu-live" type="search" placeholder="Lọc nhanh trong danh sách...">
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Khách hàng</th><th>Số điện thoại</th><th class="num">Điểm</th><th>Tài khoản</th><th>Thao tác</th></tr>
            </thead>
            <tbody id="cu-body">
                {{#each customers}}
                <tr class="cu-row" data-acc="{{#if noAccount}}noacc{{else}}acc{{/if}}" data-points="{{points}}" data-text="{{code}} {{name}} {{phone}}">
                    <td>
                        <div class="cu-who">
                            <span class="avatar">{{initials name}}</span>
                            <div>
                                <b>{{name}}</b>
                                <div class="cu-sub"><span class="mono">{{code}}</span>{{#if address}} · {{address}}{{/if}}</div>
                            </div>
                        </div>
                    </td>
                    <td class="nowrap">{{phone}}</td>
                    <td class="num"><b>{{formatNumber points}}</b></td>
                    <td>
                        {{#if noAccount}}<span class="badge badge-warn">Chưa có tài khoản</span>
                        {{else}}<span class="badge badge-ok">{{roleLabel role}}</span>{{/if}}
                    </td>
                    <td>
                        <div class="table-actions">
                            <a href="/orders/create?customer={{code}}" class="btn btn-primary btn-sm">Tạo đơn</a>
                            {{#if canReset}}
                            <form action="/admin/customers/{{_id}}/reset-link" method="POST">
                                {{> csrf}}
                                <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Tạo link đặt lại mật khẩu cho {{name}}? Chỉ làm khi đã xác minh đúng khách tại quầy.')">Quên mật khẩu</button>
                            </form>
                            {{/if}}
                        </div>
                        {{#if noAccount}}
                        <details class="cu-activate">
                            <summary>Cấp tài khoản đăng nhập</summary>
                            <form action="/admin/customers/{{_id}}/activate" method="POST" class="svc-edit">
                                {{> csrf}}
                                <input class="field-input" type="text" name="password" minlength="8" maxlength="72" required placeholder="Mật khẩu (≥ 8 ký tự)" autocomplete="off" aria-label="Mật khẩu cấp cho {{name}}">
                                <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Cấp tài khoản đăng nhập cho {{name}}? Chỉ làm khi đã xác minh đúng khách tại quầy.')">Cấp tài khoản</button>
                            </form>
                        </details>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="cu-empty" id="cu-empty" hidden>Không có khách nào khớp bộ lọc.</div>
    <div class="note cu-note">Hiển thị tối đa 50 khách mới nhất khớp từ khóa.</div>
    {{else}}
    <div class="empty-state">Không tìm thấy khách hàng nào.<small>Thử từ khóa khác hoặc thêm khách vãng lai ở trên.</small></div>
    {{/if}}
</div>

<script>
(function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('.cu-row'));
    if (!rows.length) return;
    var c = { all: rows.length, acc: 0, noacc: 0 }, pts = 0, filter = 'all';
    rows.forEach(function (r) { c[r.dataset.acc]++; pts += Number(r.dataset.points) || 0; });
    document.getElementById('cu-total').textContent = c.all;
    document.getElementById('cu-acc').textContent = c.acc;
    document.getElementById('cu-noacc').textContent = c.noacc;
    document.getElementById('cu-points').textContent = pts.toLocaleString('vi-VN');
    document.querySelectorAll('.tab-n').forEach(function (el) { el.textContent = c[el.dataset.n]; });

    var live = document.getElementById('cu-live');
    function apply() {
        var kw = live.value.trim().toLowerCase(), shown = 0;
        rows.forEach(function (r) {
            var ok = (filter === 'all' || r.dataset.acc === filter) && (!kw || r.dataset.text.toLowerCase().indexOf(kw) > -1);
            r.hidden = !ok; if (ok) shown++;
        });
        document.getElementById('cu-empty').hidden = shown > 0;
    }
    document.querySelectorAll('#cu-tabs a').forEach(function (t) {
        t.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelectorAll('#cu-tabs a').forEach(function (x) { x.classList.remove('active'); });
            t.classList.add('active'); filter = t.dataset.f; apply();
        });
    });
    live.addEventListener('input', apply);
})();
</script>