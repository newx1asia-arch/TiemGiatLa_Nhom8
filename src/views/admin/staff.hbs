<div class="page-head">
    <div>
        <h1>Quản lý nhân viên</h1>
        <p>Cấp / thu hồi quyền nhân viên và theo dõi hiệu suất làm việc trong tháng.</p>
    </div>
</div>

{{#if notice}}<div class="alert {{notice.cls}}">{{notice.text}}</div>{{/if}}

<section class="card">
    <div class="card-head"><h3>Thêm nhân viên</h3></div>
    <form action="/admin/staff" method="POST" class="inline-form">
{{> csrf}}
        <div class="field-group">
            <label class="field-label" for="phone">Số điện thoại tài khoản</label>
            <input class="field-input" id="phone" type="text" name="phone" placeholder="VD: 0912345678" required>
            <span class="field-hint">Người này cần đăng ký tài khoản trên web trước, và đăng nhập lại sau khi được cấp quyền.</span>
        </div>
        <button type="submit" class="btn btn-primary">{{> icon name="plus"}} Cấp quyền nhân viên</button>
    </form>
</section>

<section class="card">
    <div class="card-head"><h3>So sánh hiệu suất (tháng này)</h3></div>
    {{{teamChart}}}
</section>

<section class="card flush">
    <div class="card-head">
        <h3>Danh sách ({{rows.length}} người)</h3>
    </div>
    {{#if rows.length}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th class="num">Đơn lập (hôm nay / tháng)</th>
                    <th class="num">Cập nhật TT (hôm nay / tháng)</th>
                    <th class="num">Đã giao (tháng)</th>
                    <th class="num">Doanh số đơn đã lập</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                {{#each rows}}
                <tr>
                    <td><b>{{name}}</b>{{#if isSelf}} <span class="muted">(Bạn)</span>{{/if}}{{#if code}}<br><span class="muted mono">{{code}}</span>{{/if}}</td>
                    <td class="nowrap">{{phone}}</td>
                    <td><span class="badge {{#eq role 'owner'}}badge-owner{{else}}badge-staff{{/eq}}">{{roleLabel role}}</span></td>
                    <td class="num">{{createdToday}} / {{createdMonth}}</td>
                    <td class="num">{{updatesToday}} / {{updatesMonth}}</td>
                    <td class="num">{{deliveredMonth}}</td>
                    <td class="num">{{formatPrice revenueMonth}}</td>
                    <td>
                        {{#if canRevoke}}
                        <form action="/admin/staff/{{_id}}/revoke" method="POST" class="table-actions"
                              onsubmit="return confirm('Thu hồi quyền nhân viên của tài khoản này?')">
{{> csrf}}
                            <button type="submit" class="btn btn-danger btn-sm">Thu hồi quyền</button>
                        </form>
                        {{else}}
                        <span class="muted">—</span>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="empty-state">Chưa có nhân viên nào.</div>
    {{/if}}
</section>
