<div class="card auth-card error-page">
    <h1 class="error-code">403</h1>
    <h2>{{#if pageTitle}}{{pageTitle}}{{else}}Không có quyền truy cập{{/if}}</h2>
    <p class="muted">{{#if message}}{{message}}{{else}}Trang này chỉ dành cho nhân viên và chủ tiệm. Nếu bạn là nhân viên, hãy nhờ chủ tiệm cấp quyền cho tài khoản của bạn.{{/if}}</p>
    <a href="/" class="btn btn-primary">Về trang chủ</a>
</div>
